# Production environment configuration for docker-compose.prod.yml.
# Copy to .env at the repo root and fill in real values. NEVER commit
# the resulting .env file.

# --- Postgres ---
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=changeme-use-a-real-generated-password
POSTGRES_DB=clientflow
# Must reference the values above, with `postgres` as the host (the
# Docker Compose service name, resolved via the internal network).
DATABASE_URL=postgresql://clientflow:changeme-use-a-real-generated-password@postgres:5432/clientflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=2

# --- Backend ---
ENVIRONMENT=production
UVICORN_WORKERS=2
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# The real frontend origin(s) — never a wildcard, never localhost in
# production. JSON array of strings, e.g. ["https://app.clientflow.com"]
CORS_ORIGINS=["https://your-production-domain.example.com"]

# --- Stripe ---
# https://dashboard.stripe.com/apikeys — use a LIVE key only once
# billing has been manually verified end-to-end against Stripe's test
# mode first (see README "Stripe setup").
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — created after deploying, once
# the public webhook URL (https://your-api-domain/api/v1/billing/webhook)
# is reachable. Copy the signing secret Stripe shows you, starts with whsec_.
STRIPE_WEBHOOK_SECRET=
# The Price ID for the Pro plan, from the Stripe Dashboard's Product catalog.
STRIPE_PRICE_ID_PRO=

# --- Resend ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain verified in your Resend account, not an arbitrary address.
EMAIL_FROM=noreply@your-verified-domain.example.com

# --- Frontend ---
# Baked into the static build at build time (Vite env vars are
# compile-time) — must be the real, public API URL.
VITE_API_BASE_URL=https://your-api-domain.example.com/api/v1
