# Test-only configuration. Committed to the repo — not a real secret,
# same rationale as any other CI/test fixture config. Used exclusively
# by pytest (auto-loaded by backend/conftest.py) and never by the app
# itself in normal (dev/prod) operation.
#
# Points at a SEPARATE database (clientflow_test) from dev (clientflow)
# so running the test suite can never touch or truncate dev data.

ENVIRONMENT=test

DATABASE_URL=postgresql://clientflow:clientflow@localhost:5432/clientflow_test
REDIS_URL=redis://localhost:6379/1

JWT_SECRET_KEY=test-only-secret-never-used-outside-pytest
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

RESEND_API_KEY=
EMAIL_FROM=noreply@clientflow.dev
