# App
# development | production | test
# NOTE: "test" specifically disables the login/register rate limiter
# (see app/core/rate_limit.py) — this value is set exclusively by
# backend/.env.test, never here or in any real deployment.
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://clientflow:clientflow@postgres:5432/clientflow

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Auth — generate a real secret before any real deployment, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — real production origin(s) only, never a wildcard.
CORS_ORIGINS=["http://localhost:5173"]

# Stripe — https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks (webhook secret is only shown
# once you've registered the webhook endpoint URL in the Stripe
# Dashboard, which needs a publicly reachable deployment first).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Email — https://resend.com/api-keys. EMAIL_FROM must be on a domain
# verified in your Resend account, or sends will fail.
RESEND_API_KEY=
EMAIL_FROM=noreply@clientflow.dev
